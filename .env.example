# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://mirage:mirage@localhost:5432/mirage"

# Secret key for the audit hash chain (HMAC-SHA256). Min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it stable: changing it makes existing audit chains fail verification.
AUDIT_HMAC_SECRET="replace-with-a-long-random-string-at-least-32-chars"
